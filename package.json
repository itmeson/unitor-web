{
	"name": "unitor-web",
	"version": "0.1.0",
	"description": "A pedagogical dimensional-analysis tool for physics/science students. Web-app port of the Unitor Obsidian plugin.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node scripts/run-harness.mjs",
		"lint": "eslint ."
	},
	"keywords": [
		"dimensional-analysis",
		"physics",
		"units",
		"pedagogy"
	],
	"author": "Mark Betnel <mbetnel@seattleacademy.org>",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"@types/pako": "^2.0.4",
		"esbuild": "0.25.5",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"pako": "^2.1.0"
	}
}
